# ==============================================================================
# Zed Multi-Agent Environment Configuration (.env)
# ==============================================================================
# Скопируйте этот файл в корень проекта с именем `.env`:
#   cp docs/.env.example .env
#
# Файл `.env` автоматически загружается редактором при открытии проекта
# и реактивно обновляется при сохранении изменений (Hot Reload).
# Переменные используются для интерполяции в `.zed/settings.json` через ${VAR},
# а также передаются встроенным MCP-серверам и провайдерам LLM.
#
# ВНИМАНИЕ: Никогда не коммитьте реальный `.env` с секретами в Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Модели LLM для агентов (Используются в .zed/settings.json)
# ------------------------------------------------------------------------------

# Флагманская модель (Frontier Model) — для оркестратора, системного архитектора и ревьюера
# Рекомендуются: claude-3-7-sonnet-latest, claude-3-5-sonnet-latest, gpt-4o
FRONTIER_MODEL_PROVIDER=anthropic
FRONTIER_MODEL=claude-3-7-sonnet-latest

# Модель среднего уровня (Mid-Tier Model) — для субагентов-инженеров и быстрых задач
# Рекомендуются: claude-3-5-haiku-latest, gpt-4o-mini, deepseek-chat
MID_TIER_MODEL_PROVIDER=anthropic
MID_TIER_MODEL=claude-3-5-haiku-latest

# ------------------------------------------------------------------------------
# 2. API-ключи провайдеров LLM
# ------------------------------------------------------------------------------

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT-4o, o1, o3-mini)
OPENAI_API_KEY=sk-proj-...

# Google AI (Gemini)
GOOGLE_AI_API_KEY=AIzaSy...

# DeepSeek
DEEPSEEK_API_KEY=sk-...

# Groq (сверхбыстрый инференс Llama / Mixtral)
GROQ_API_KEY=gsk_...

# Локальный Ollama (если используется локальный инференс)
OLLAMA_API_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. Control Plane: Task Graph Service (TGS / .zed/mcp/taskgraph)
# ------------------------------------------------------------------------------

# Идентификатор текущего проекта в графе задач
TGS_PROJECT_ID=zed

# Путь к SQLite базе данных графа задач (относительно корня проекта)
TGS_DB_PATH=.zed/mcp/taskgraph/taskgraph.db

# Уровень логирования TGS: trace, debug, info, warn, error
TGS_LOG_LEVEL=warn

# Путь к файлу логов TGS
TGS_LOG_FILE=.zed/mcp/taskgraph/taskgraph.log

# ------------------------------------------------------------------------------
# 4. Межагентная шина: Agent Bus (.zed/mcp/agent-bus)
# ------------------------------------------------------------------------------

# Идентификатор проекта для шины сообщений и обратной связи
AGENT_BUS_PROJECT_ID=zed
