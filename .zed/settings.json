{
  "languages": {
    "Markdown": {
      "tab_size": 2,
      "formatter": "prettier",
    },
    "TOML": {
      "formatter": "prettier",
      "format_on_save": "off",
    },
    "YAML": {
      "tab_size": 2,
      "formatter": "prettier",
    },
    "JSON": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "formatter": "prettier",
    },
    "JSONC": {
      "tab_size": 2,
      "preferred_line_length": 120,
      "formatter": "prettier",
    },
    "JavaScript": {
      "tab_size": 2,
      "formatter": "prettier",
    },
    "CSS": {
      "tab_size": 2,
      "formatter": "prettier",
    },
    "Rust": {
      "tasks": {
        "variables": {
          "RUST_DEFAULT_PACKAGE_RUN": "zed",
        },
      },
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "procMacro": {
          "processes": 4,
        },
      },
    },
  },
  "file_types": {
    "Dockerfile": ["Dockerfile*[!dockerignore]"],
    "JSONC": ["**/assets/**/*.json", "renovate.json"],
    "Git Ignore": ["dockerignore"],
  },
  "hard_tabs": false,
  "formatter": "auto",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "file_scan_exclusions": [
    "crates/agent/src/tools/evals/fixtures",
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "read_only_files": ["**/.rustup/**", "**/.cargo/registry/**", "**/.cargo/git/**", "target/**/*.rs", "**/*.lock"],
  "context_servers": {
    "skills-hub": {
      "command": "npx",
      "args": [
        "-y",
        "@skills-hub-ai/mcp"
      ]
    },
    "mcpfinder": {
      "command": "npx",
      "args": [
        "-y",
        "@mcpfinder/server"
      ]
    },
    "agent-bus": {
      "command": "agent-bus",
      "args": [
        "--db",
        ".zed/mcp/agent-bus/messages.db",
        "--topics-file",
        ".zed/mcp/agent-bus/topics.jsonc",
        "--log-level",
        "warn",
        "--log-file",
        ".zed/mcp/agent-bus/agent-bus.log"
      ],
      "env": {
        "AGENT_BUS_PROJECT_ID": "zed"
      },
      "platforms": {
        "darwin-arm64": { "command": ".zed/mcp/agent-bus/bin/agent-bus-darwin-arm64" },
        "darwin-amd64": { "command": ".zed/mcp/agent-bus/bin/agent-bus-darwin-amd64" },
        "darwin-x64": { "command": ".zed/mcp/agent-bus/bin/agent-bus-darwin-amd64" },
        "linux-arm64": { "command": ".zed/mcp/agent-bus/bin/agent-bus-linux-arm64" },
        "linux-amd64": { "command": ".zed/mcp/agent-bus/bin/agent-bus-linux-amd64" },
        "linux-x64": { "command": ".zed/mcp/agent-bus/bin/agent-bus-linux-amd64" },
        "windows-arm64": { "command": ".zed/mcp/agent-bus/bin/agent-bus-windows-arm64.exe" },
        "windows-amd64": { "command": ".zed/mcp/agent-bus/bin/agent-bus-windows-amd64.exe" },
        "windows-x64": { "command": ".zed/mcp/agent-bus/bin/agent-bus-windows-amd64.exe" },
        "macos": { "command": ".zed/mcp/agent-bus/bin/agent-bus-darwin-arm64" },
        "linux": { "command": ".zed/mcp/agent-bus/bin/agent-bus-linux-amd64" },
        "windows": { "command": ".zed/mcp/agent-bus/bin/agent-bus-windows-amd64.exe" }
      }
    },
    "taskgraph": {
      "command": "taskgraph",
      "args": [],
      "env": {
        "TGS_PROJECT_ID": "zed",
        "TGS_DB_PATH": ".zed/mcp/taskgraph/taskgraph.db",
        "TGS_LOG_LEVEL": "warn",
        "TGS_LOG_FILE": ".zed/mcp/taskgraph/taskgraph.log"
      },
      "platforms": {
        "darwin-arm64": { "command": ".zed/mcp/taskgraph/bin/taskgraph-darwin-arm64" },
        "darwin-amd64": { "command": ".zed/mcp/taskgraph/bin/taskgraph-darwin-amd64" },
        "darwin-x64": { "command": ".zed/mcp/taskgraph/bin/taskgraph-darwin-amd64" },
        "linux-arm64": { "command": ".zed/mcp/taskgraph/bin/taskgraph-linux-arm64" },
        "linux-amd64": { "command": ".zed/mcp/taskgraph/bin/taskgraph-linux-amd64" },
        "linux-x64": { "command": ".zed/mcp/taskgraph/bin/taskgraph-linux-amd64" },
        "windows-arm64": { "command": ".zed/mcp/taskgraph/bin/taskgraph-windows-arm64.exe" },
        "windows-amd64": { "command": ".zed/mcp/taskgraph/bin/taskgraph-windows-amd64.exe" },
        "windows-x64": { "command": ".zed/mcp/taskgraph/bin/taskgraph-windows-amd64.exe" },
        "macos": { "command": ".zed/mcp/taskgraph/bin/taskgraph-darwin-arm64" },
        "linux": { "command": ".zed/mcp/taskgraph/bin/taskgraph-linux-amd64" },
        "windows": { "command": ".zed/mcp/taskgraph/bin/taskgraph-windows-amd64.exe" }
      }
    }
  },
